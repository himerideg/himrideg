NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/himrideg_v2

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Local default: <server>/uploads
# Production example: /var/data/himrideg-uploads
UPLOAD_ROOT=

RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

FAST2SMS_API_KEY=replace_with_fast2sms_api_key
SMS_ENABLED=false
