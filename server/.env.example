NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/himrideg_v2

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
UPLOAD_ROOT=

# Local dev default OFF. Production example file has real-money settings ON.
REAL_MONEY_MODE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RAZORPAYX_PAYOUTS_ENABLED=false
# Existing Razorpay merchant ho to X key fields blank rakhne par RAZORPAY keys fallback hoti hain.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_API_BASE=https://api.razorpay.com/v1
PAYOUT_SCHEDULER_INTERVAL_MS=300000

FAST2SMS_API_KEY=
SMS_ENABLED=false

