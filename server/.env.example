NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/himrideg_v2

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
UPLOAD_ROOT=

# Local dev default OFF. Production example file has real-money settings ON.
REAL_MONEY_MODE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RAZORPAYX_PAYOUTS_ENABLED=false
# Existing Razorpay merchant ho to X key fields blank rakhne par RAZORPAY keys fallback hoti hain.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_API_BASE=https://api.razorpay.com/v1
PAYOUT_SCHEDULER_INTERVAL_MS=300000

FAST2SMS_API_KEY=
SMS_ENABLED=false

# Geoapify Map API (autocomplete, reverse geocoding, routing)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Google Identity Services (public OAuth Web Client ID)
GOOGLE_CLIENT_ID=691367484066-udd03uov2vsf8el8v8o3d6n3503b2rja.apps.googleusercontent.com

# ================================================================
# Phase 2 Scalability — Redis / multi-server sockets / GPS cache
# Redis na ho to REDIS_ENABLED=false rakho; current single-server flow chalega.
# ================================================================
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=
REDIS_KEY_PREFIX=himrideg:v2
REDIS_CONNECT_TIMEOUT_MS=10000
SOCKET_REDIS_ADAPTER_ENABLED=true
LIVE_LOCATION_CACHE_ENABLED=true
LIVE_LOCATION_CACHE_TTL_SECONDS=90
LIVE_LOCATION_ACCESS_TTL_SECONDS=8
LIVE_LOCATION_MONGO_PERSIST_MS=15000
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_QUEUE=jobs:default
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_RETRY_DELAY_MS=1500
BACKGROUND_JOB_BLOCKING_POP_SECONDS=1
