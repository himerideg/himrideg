NODE_ENV=production

# Render injects PORT automatically. Do not hard-code it unless required.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/himrideg_v2

JWT_ACCESS_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=https://himrideg.com,https://www.himrideg.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Render persistent disk mount path
UPLOAD_ROOT=/var/data/himrideg-uploads

# REAL MONEY MODE: test keys reject honge.
REAL_MONEY_MODE=true
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CREATE_A_SEPARATE_LONG_WEBHOOK_SECRET

# RazorpayX live payouts. Existing Razorpay merchant ho to X keys blank chhod kar
# RAZORPAY_KEY_ID/SECRET fallback use ho sakta hai; otherwise RazorpayX live keys do.
RAZORPAYX_PAYOUTS_ENABLED=true
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=YOUR_RAZORPAYX_CURRENT_ACCOUNT_OR_CUSTOMER_IDENTIFIER
RAZORPAYX_WEBHOOK_SECRET=CREATE_A_DIFFERENT_LONG_PAYOUT_WEBHOOK_SECRET
RAZORPAYX_API_BASE=https://api.razorpay.com/v1
PAYOUT_SCHEDULER_INTERVAL_MS=300000

FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY
SMS_ENABLED=true
