NODE_ENV=production

# Render injects PORT automatically. Do not hard-code it unless required.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/himrideg_v2

JWT_ACCESS_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=https://himrideg.com,https://www.himrideg.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Render persistent disk mount path
UPLOAD_ROOT=/var/data/himrideg-uploads

RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY
SMS_ENABLED=true

# Launch security / payment webhook / production maps
RAZORPAY_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_WEBHOOK_SECRET
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY
ADMIN_EMAIL=himrideg@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=GENERATE_A_STRONG_MINIMUM_16_CHAR_PASSWORD
